# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Public base URL of this server (used for QR onboarding + Twilio webhook).
# In dev, paste your ngrok HTTPS URL here, e.g. https://abc-12-34.ngrok-free.app
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Twilio
# Sandbox sender format: whatsapp:+14155238886
# Multiple numbers can be rotated; comma-separated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBERS=whatsapp:+14155238886
# Sandbox join code shown to the user during QR onboarding (Twilio sandbox only)
TWILIO_SANDBOX_JOIN_CODE=join example-word
# Validate inbound Twilio request signatures
TWILIO_VALIDATE_SIGNATURE=true

# RAG configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
DEFAULT_TOP_K=4
MAX_CONTEXT_CHUNKS=4

# Generation backend: extractive | groq
GENERATION_BACKEND=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
